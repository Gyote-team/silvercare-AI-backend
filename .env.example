# PostgreSQL 접속 주소. Spring 로컬 Docker DB와 같은 값이다.
DATABASE_URL=postgresql+psycopg://silvercare:silvercare_local@127.0.0.1:5432/silvercare

# Spring이 AI 서버를 호출할 때 쓰는 내부 토큰. Spring .env의 AI_INTERNAL_TOKEN과 같은 값을 넣는다.
AI_INTERNAL_TOKEN=

# Spring이 업로드 원본을 저장하는 폴더의 절대 경로.
STORAGE_LOCAL_ROOT=

# Gemini OpenAI 호환 API. 실제 키는 .env에만 두고 Git에 올리지 않습니다.
LLM_PROVIDER=gemini_openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_REASONING_EFFORT=low
