# 환경 변수 파일 (예시 파일만 커밋)
.env
.env.*
!.env.example

# 가상환경
.venv/
venv/
env/

# Python 빌드·캐시 산출물
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 도구 캐시와 커버리지 결과
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE 설정
.idea/
.vscode/

# OS 생성 파일
.DS_Store
Thumbs.db

# 로컬 산출물 (로그, 루트의 로컬 데이터 폴더)
*.log
/data/
